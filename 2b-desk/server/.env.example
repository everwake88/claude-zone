# ---------------------------------------------------------------------------
# 2B Desk server settings. Set these in Coolify (Environment Variables) or in
# a .env file next to docker-compose.yml. Never commit real values.
# ---------------------------------------------------------------------------

# Postgres. Use the same database as the 2B AI agent: the desk keeps all of
# its tables in its own "desk" schema and never touches "agent".
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# true if your Postgres requires SSL (managed databases usually do)
DATABASE_SSL=false

# n8n -> desk. A long random string. n8n sends it in the X-Desk-Secret header
# when it mirrors messages and hands customers over.
# Make one with:  openssl rand -hex 24
DESK_INGEST_SECRET=

# desk -> n8n. The Production URL of the "2B — Desk Outbound Sender" webhook,
# and the secret its Header Auth credential expects.
# While N8N_SEND_URL is empty the desk runs in demo mode: replies are marked
# as sent but NOT delivered to customers.
N8N_SEND_URL=
N8N_SEND_SECRET=

# The first admin, created on start-up only when there are no users yet.
# Sign in, change the password, then you can remove these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Desk Admin
ADMIN_EMPLOYEE_ID=ADMIN-1

# Only when the dashboard is hosted on another address (Vercel, Cloudflare
# Pages): that address, e.g. https://desk-2b.pages.dev  (comma-separated)
CORS_ORIGINS=

# Optional
PORT=8080
# true when the server sits behind a proxy that sets X-Forwarded-For
# (Coolify / Traefik, Nginx, Cloudflare) — used for login rate limiting.
# Set false if clients reach the server directly.
TRUST_PROXY=true
# How often the engine checks reminders / hand-overs, in milliseconds.
TICK_MS=5000
# Serve the dashboard files from this server (default true).
SERVE_WEB=true
# Demo only: virtual customers and agents. NEVER on the real database.
DEMO_MODE=false
