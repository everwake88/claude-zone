# Postgres on your own server (the database the migrations in ../database built)
DATABASE_URL=postgres://everwake_salary:CHANGE_ME@db.example.com:5432/everwake
# "require" when the server uses TLS (recommended from Vercel), "disable" on a private network
DATABASE_SSL=require
# a long random string; signs the HR sign-in cookie (openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_TO_64_RANDOM_HEX_CHARACTERS
# the n8n webhook base, shown on Settings → WhatsApp (e.g. https://n8n.example.com)
N8N_BASE_URL=https://n8n.example.com
