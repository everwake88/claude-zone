# =====================================================================
# Everwake · the n8n server's settings. Copy to .env and fill in:
#   ./scripts/make-env.sh      (fills in the secrets for you)
# Keep a copy of the finished .env in your password manager: without
# N8N_ENCRYPTION_KEY, n8n's saved credentials cannot be read after a rebuild.
# =====================================================================

# the address n8n answers on — point its DNS A record at this server first
N8N_HOST=n8n.everwake.tech

# where Let's Encrypt writes if a certificate ever needs attention
ACME_EMAIL=you@example.com

# the n8n version: the SAME one your current n8n runs (Help → About n8n),
# so the workflows behave exactly as they do today. Upgrade later on purpose.
N8N_VERSION=

# secrets (make-env.sh generates these; never reuse them anywhere else)
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
REDIS_PASSWORD=

TIMEZONE=Africa/Cairo

# ---- sizing: KVM 1 (1 CPU, 4 GB). Raise these when the server grows. ------------
# conversations n8n works on at the same moment; more wait their turn
N8N_CONCURRENCY=10
# n8n's memory: the JavaScript heap, and the container's hard cap above it
N8N_HEAP_MB=1536
N8N_MEM_LIMIT=2g
N8N_RUNNER_HEAP_MB=512

# ---- Phase 2: queue mode. Keep "regular" on KVM 1. ---------------------------------
# On KVM 4: EXECUTIONS_MODE=queue, then `docker compose --profile queue up -d`
EXECUTIONS_MODE=regular
N8N_WORKER_MEM_LIMIT=1536m

# ---- backups (scripts/backup.sh) ----------------------------------------------------
# days of nightly backups kept on this server
BACKUP_KEEP_DAYS=14
# optional: an rclone remote to copy each backup off the server, e.g. "gdrive:everwake-backups"
BACKUP_REMOTE=
