# ---- Supabase (Project Settings → API) --------------------------------------
# Add the `clinic` schema under Settings → API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# server only — never prefix with NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI price-list import ------------------------------------------------------
OPENAI_API_KEY=sk-...
# a model that reads PDFs and photos; the one the agent uses is fine
CATALOG_AI_MODEL=gpt-5.6-luna

# ---- n8n ------------------------------------------------------------------------
# the public address of your n8n (no trailing slash)
N8N_BASE_URL=https://n8n.example.com
# the value of the "Everwake Clinic Outbox Secret" header credential in n8n
N8N_OUTBOX_SECRET=change-me-to-a-long-random-string
# the token the Main workflow's team-answer webhook checks (Settings → WhatsApp shows it too)
N8N_TEAM_SECRET=change-me-too
