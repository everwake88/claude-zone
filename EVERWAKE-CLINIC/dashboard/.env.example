# ---- Supabase (Project Settings → API) --------------------------------------
# Add the `clinic` schema under Settings → API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# server only — never prefix with NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI price-list import ------------------------------------------------------
OPENAI_API_KEY=sk-...
# a model that reads PDFs and photos; the one the agent uses is fine
CATALOG_AI_MODEL=gpt-5.6-luna

# ---- n8n ------------------------------------------------------------------------
# the public address of your n8n (no trailing slash)
N8N_BASE_URL=https://n8n.example.com
# the value of the "Everwake Clinic Outbox Secret" header credential in n8n
N8N_OUTBOX_SECRET=change-me-to-a-long-random-string

# ---- Listening to the visit (the scribe) ----------------------------------------
# All use OPENAI_API_KEY. Without it the doctor types the note; nothing is recorded.
SCRIBE_TRANSCRIBE_MODEL=gpt-transcribe          # hears each 20-second piece while the visit goes on
SCRIBE_DIARIZE_MODEL=gpt-4o-transcribe-diarize  # who said what, after Stop ('off' to skip)
SCRIBE_EXTRACT_MODEL=gpt-5.6-luna               # fills the doctor's form, a quote behind every value
SCRIBE_VERIFY_MODEL=gpt-5-mini                  # the independent check of every filled field

# ---- The doctor's assistant (chat and voice) -------------------------------------
ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_TRANSCRIBE_MODEL=gpt-transcribe       # push-to-talk
ASSISTANT_TTS_MODEL=gpt-4o-mini-tts             # "read replies aloud"
